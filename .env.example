# Copy this file to .env and replace every change-* value before deployment.
POSTGRES_DB=puzzary
POSTGRES_USER=puzzary
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://puzzary:change-me@db:5432/puzzary
APP_BASE_URL=http://localhost:8790
UPLOAD_DIR=/data/uploads
SESSION_SECRET=change-this-session-secret
GROUP_HOST_RECONNECT_GRACE_SECONDS=30

# Optional transport security. HTTP remains the default.
PUZZARY_HOST=0.0.0.0
PUZZARY_PORT=8790
PUZZARY_TLS_CERT_FILE=
PUZZARY_TLS_KEY_FILE=
PUZZARY_TLS_KEY_PASSWORD=
PUZZARY_TRUSTED_PROXIES=
PUZZARY_HTTPS_REDIRECT=false
PUZZARY_SECURE_COOKIES=auto

# Optional Web Push overrides. Puzzary otherwise generates and persists a VAPID key.
PUZZARY_VAPID_PRIVATE_KEY=
PUZZARY_VAPID_SUBJECT=mailto:notifications@puzzary.local
PUZZARY_PUSH_LOOP_SECONDS=10

# Trusted puzzle packages are persisted inside the existing ./data volume.
PUZZARY_PLUGIN_DIR=/data/plugins
